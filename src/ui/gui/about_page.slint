import { Button, HorizontalBox, Palette } from "std-widgets.slint";
import { Page } from "page.slint";
import { SectionHeading, HintText, Divider } from "common.slint";

export global AboutData {
    in property <string> version;
    in property <bool> has_update;
}

export component NewVersionButton {
    callback newversion_button_clicked;
    HorizontalBox {
        padding: 0px;
        alignment: start;
        Button {
            text: @tr("New version available — download");
            primary: true;
            clicked => {
                newversion_button_clicked();
            }
        }
    }
}

export component About inherits Page {
    callback wiki_button_clicked;
    callback discord_button_clicked;
    callback newversion_button_clicked;
    callback patreon_button_clicked;
    callback github_sponsors_button_clicked;
    callback source_code_button_clicked;
    title: @tr("About");

    VerticalLayout {
        spacing: 14px;
        max-width: 560px;

        VerticalLayout {
            spacing: 2px;

            Text {
                text: "Gopher64";
                font-size: 22px;
                font-weight: 700;
            }

            Text {
                text: AboutData.version;
                font-size: 13px;
                color: Palette.foreground.transparentize(0.4);
            }
        }

        if AboutData.has_update: NewVersionButton {
            newversion_button_clicked => {
                newversion_button_clicked();
            }
        }

        Divider { }

        SectionHeading {
            text: @tr("Learn");
        }

        HorizontalLayout {
            alignment: start;
            spacing: 8px;

            Button {
                text: @tr("Wiki");
                clicked => {
                    wiki_button_clicked();
                }
            }

            Button {
                text: @tr("Discord Server");
                clicked => {
                    discord_button_clicked();
                }
            }

            Button {
                text: @tr("Source Code");
                clicked => {
                    source_code_button_clicked();
                }
            }
        }

        Divider { }

        SectionHeading {
            text: @tr("Support Development");
        }

        HintText {
            text: @tr("Gopher64 is free and open source. Donations fund the time that goes into it.");
        }

        HorizontalLayout {
            alignment: start;
            spacing: 8px;

            Button {
                text: @tr("Patreon");
                clicked => {
                    patreon_button_clicked();
                }
            }

            Button {
                text: @tr("GitHub Sponsors");
                clicked => {
                    github_sponsors_button_clicked();
                }
            }
        }
    }
}
